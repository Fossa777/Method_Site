    "patterns": [
  {
    "id": "crypt_ich_like",
    "title": "Cryptocaryon / Ichthyophthirius",
    "match": {
      "any": [
        ["zone-skin:effect-ciliate-many"],
        ["zone-skin:effect-ciliate-few"]
      ]
    },
    "reinforcement": {
      "any": [
        "native:zone-skin:cryptocaryon_theront",
        "native:zone-skin:cryptocaryon_trophont",
        "native:zone-skin:ichthyophthirius"
      ]
    },
    "meaning": "White spots on the skin may indicate ciliate involvement of the integument. If the gills are involved, the risk of impaired gas exchange increases.",
    "next_steps": [
      "Microscopy of body mucus",
      "Microscopy of gill mucus",
      "Stained smear from the body surface"
    ]
  },
        {
  "id": "mucus_response",
  "title": "Excessive mucus production",
  "match": {
    "all": [
      "zone-skin:effect-mucus",
      "zone-gills:bacterial_mucus_1"
    ]
  },
  "meaning": "The body and gills are covered with excessive mucus. This may represent a response to environmental stress or another irritant.",
  "next_steps": [
    "Microscopy of a wet mount of mucus",
    "Scrapings from the body and gills",
    "Assessment of respiration and signs of asphyxia"
  ]
},
        {
  "id": "granulomatosis",
  "title": "Granulomatous process",
  "match": {
    "any": [
      ["zone-spleen:granulomas"]
    ]
  },
  "reinforcement": {
    "all": [
      "native:zone-spleen:splenic_granulomas"
    ]
  },
  "meaning": "Granulomatous lesions are present in the spleen. Further investigation is required to determine the nature of the granulomas.",
  "next_steps": [
    "Microscopy of a spleen squash preparation",
    "Ziehl-Neelsen staining",
    "Search for intracellular parasites"
  ]
},
        {
  "id": "acid_fast_granulomatosis",
  "title": "Granulomatous process with acid-fast bacteria",
  "match": {
    "all": [
      "zone-spleen:granulomas",
      "stained:zone-spleen:acid_fast_bacteria"
    ]
  },
  "meaning": "Granulomatous lesions of the spleen are accompanied by acid-fast bacteria. A mycobacterial etiology becomes more likely.",
  "next_steps": [
    "Check other organs for granulomas",
    "Perform Ziehl-Neelsen staining of kidney and liver smears",
    "Compare findings with emaciation, chronic course, and focal lesions"
  ]
},
        
        {
  "id": "intracellular_parasites_pattern",
  "title": "Intracellular parasites",
  "match": {
    "any": [
      ["zone-spleen:granulomas"]
    ]
  },
  "reinforcement": {
    "any": [
      "stained:zone-spleen:intracellular_structures_1",
      "stained:zone-spleen:intracellular_structures_2"
    ]
  },
  "meaning": "Granulomatous involvement of the spleen may be associated with intracellular parasites.",
  "next_steps": [
    "Microscopy of a spleen squash preparation",
    "Ziehl-Neelsen staining",
    "Search for intracellular structures"
  ]
},
        
        {
  "id": "microcirculation_disorder",
  "title": "Systemic microcirculatory disorder",
  "match": {
    "all": [
      "zone-gills:dark-red",
      "zone-liver:hyperemia",
      "zone-spleen:hyperemia-severe",
      "zone-intestine:white-crystalline-masses"
    ]
  },
  "reinforcement": {
    "any": [
      [
        "native:zone-liver:hepatic_erythrocyte_clusters",
        "native:zone-spleen:splenic_hyperemia",
        "zone-kidney_g:hyperemia"
      ],
      [
        "native:zone-liver:hepatic_focal_erythrocyte_clusters",
        "native:zone-spleen:splenic_hyperemia",
        "zone-kidney_g:hyperemia"
      ],
      [
        "native:zone-liver:hepatic_ischemic_zone",
        "native:zone-spleen:splenic_hyperemia",
        "zone-kidney_g:hyperemia"
      ]
    ]
  },
  "meaning": "Findings are consistent with systemic circulatory and microcirculatory disturbance. Possible causes include intoxication, hypoxia, impaired gas exchange, or other severe internal disorders.",
  "next_steps": [
    "Microscopy of a gill filament squash preparation",
    "Stained smears from gill filaments",
    "Stained smears from internal organs",
    "Microscopy of intestinal contents"
  ]
},
        
        {
  "id": "intestinal_infection",
  "title": "Intestinal infection",
  "match": {
    "any": [
      ["zone-intestine:transparent-intestinal-wall"],
      ["zone-intestine:white-crystalline-masses"]
    ]
  },
  "reinforcement": {
    "any": [
      "stained:zone-intestine:intestinal_spore_forming_bacteria",
      "stained:zone-intestine:intestinal_yeast_like_structures",
      "stained:zone-intestine:intestinal_bacterial_overgrowth"
    ]
  },
  "meaning": "Intestinal changes are accompanied by disruption of the microbiota or an infectious process.",
  "next_steps": [
    "Stained smear of intestinal contents",
    "Microscopy of intestinal contents",
    "Assessment of the liver and kidneys"
  ]
},
        
        
  {
    "id": "dinoflagellate_like",
    "title": "Dinoflagellate involvement",
    "match": {
      "any": [
        ["zone-skin:effect-dinoflag"]
      ]
    },
    "reinforcement": {
      "any": [
        "native:zone-skin:amyloodinium"
      ]
    },
    "meaning": "A fine dust-like coating on the skin may indicate dinoflagellate involvement. If the gills are affected, rapid respiratory compromise may occur.",
    "next_steps": [
      "Microscopy of body mucus",
      "Microscopy of gill mucus",
      "Stained smear from the body surface"
    ]
  },
  {
    "id": "gill_bacterial_problem",
    "title": "Bacterial gill involvement",
    "match": {
      "any": [
        ["zone-gills:bacterial_mucus_1"],
        ["zone-gills:bacterial_mucus_2"],
        ["zone-gills:necrosis"]
      ]
    },
    "reinforcement": {
      "any": [
        "stained:zone-gills:gill_filamentous_bacteria"
      ]
    },
    "meaning": "The gills are covered with dense mucus or show marked structural damage. Evaluation of gas exchange and microscopy of gill material should be prioritized.",
    "next_steps": [
      "Microscopy of a gill filament squash preparation",
      "Microscopy of gill mucus",
      "Staining of a gill mucus preparation"
    ]
  },
  {
    "id": "ulcerative_skin_lesion",
    "title": "Ulcerative bacterial skin lesion",
    "match": {
      "any": [
        ["zone-skin:effect-wound"]
      ]
    },
    "reinforcement": {
      "any": [
        "stained:zone-wound:wound_bacterial_colonization"
      ]
    },
    "meaning": "A non-healing ulcerative lesion with marked bacterial colonization. The bacterial process may be one of the leading factors in tissue damage.",
    "next_steps": [
      "Stained smear from the wound surface",
      "Stained smear of body mucus"
    ]
  }
],
    
    
