<script>
(() => {
  const root = document.getElementById("fossa-myco-test");
  if (!root) return;

  const img = root.querySelector("img");
const bw = img.getAttribute("src");
const color = img.dataset.color;

const preloadColor = new Image();
preloadColor.src = color;
preloadColor.decode?.().catch(() => {});




  const cells = root.querySelectorAll(".myco-test__grid button");
  const reveal = root.querySelector(".myco-test__reveal");
  const reset = root.querySelector(".myco-test__reset");
  const status = root.querySelector(".myco-test__status");

cells.forEach(cell => {
  cell.addEventListener("click", () => {
    if (root.classList.contains("is-revealed")) return;

    const selected = cell.classList.toggle("is-selected");
    cell.setAttribute("aria-pressed", String(selected));

    // Показываем кнопку, если выбран хотя бы один квадрат
    reveal.hidden = !root.querySelector(
      ".myco-test__grid button.is-selected"
    );
  });
});

  reveal.addEventListener("click", () => {
    img.src = color;
    root.classList.add("is-revealed");

reveal.hidden = true;
reset.hidden = false;

    status.textContent =
      "Цветная версия.";
  });

  reset.addEventListener("click", () => {
    img.src = bw;
    root.classList.remove("is-revealed");

    cells.forEach(cell => {
      cell.classList.remove("is-selected");
      cell.setAttribute("aria-pressed", "false");
    });

reveal.hidden = true;
reset.hidden = true;
    status.textContent = "";
  });
})();
</script>





